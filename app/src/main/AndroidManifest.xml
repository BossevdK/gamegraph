<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nodig om de eigen update (APK uit GitHub Releases) aan Android aan te bieden. Android vraagt zelf om toestemming. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".GameGraphApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GameGraph">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Herstelscherm in een eigen proces: werkt ook als het hoofdproces onbruikbaar is. -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:process=":recovery"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="nl.gamegraph.app.recovery" />

        <receiver android:name=".update.InstallStatusReceiver" android:exported="false" />
    </application>
</manifest>
